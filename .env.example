# Copy to .env (or let ./setup.sh write it), then `docker compose up -d --build`.

# ── Identity / login ─────────────────────────────────────────────
# Shown in the UI header.
WORKER_NAME=gpu-node-01
# UI admin password. Empty → generated on first start and printed in the
# log (docker compose logs worker-agent | grep password).
WORKER_ADMIN_PASSWORD=

# ── GPU / runtime ────────────────────────────────────────────────
GPU_ID=0
EVAL_MODE=real            # real | mock  (mock = UI test without a GPU)
# Host port for the UI (http://<host>:<port>/); setup.sh picks a free one.
WORKER_HOST_PORT=8081
WORKER_CONTAINER_NAME=worker-agent-8081
# Mock UI test only (no GPU, synthetic scores):
# COMPOSE_FILE=docker-compose.yml:docker-compose.mock.yml

# ── Local storage (inside the container; backed by docker volumes) ──
WORKER_STORAGE_ROOT=/var/lib/worker-agent/storage
WORKER_STATE_DIR=/var/lib/worker-agent/state

# ── HuggingFace weight downloads ─────────────────────────────────
# Optional. lerobot policy classes (multi_task_dit / smolvla / pi0 /
# groot / XVLA / act) fetch weights from huggingface.co on first eval.
# Anonymous requests are rate-limited; a read-scope token removes it.
# Get one at https://huggingface.co/settings/tokens.
HF_TOKEN=

# Episodes, episode length, timeout, device, video recording and tasks
# are set in the UI, not here.
