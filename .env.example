# ── Mode ──────────────────────────────────────────────────────────
# standalone = the school runs evals from this worker's own web UI
#              (http://<host>:<WORKER_HOST_PORT>/), no central needed.
# central    = federated leaderboard worker (needs WORKER_JOIN_TOKEN).
# Unset: central if a join token is set / already registered, else standalone.
WORKER_MODE=standalone
# Standalone UI login. Empty → generated on first start and printed in the log.
WORKER_ADMIN_PASSWORD=

# ── Central control plane (central mode only) ─────────────────────
CENTRAL_API_URL=https://hcislab.ddns.net

# ── Identity ──────────────────────────────────────────────────────
# ONLY needed on first boot. Get this from the school-admin UI:
#   /admin/dashboard → Workers tab → "+ Issue Join Token"
# After a successful register the machine JWT is cached under
# WORKER_STATE_DIR and this variable can be removed.
WORKER_JOIN_TOKEN=

# Friendly name shown in the admin Workers tab
WORKER_NAME=gpu-node-01

# Public URL a student's browser can reach for uploads.
# Central will issue presigned URLs pointing at <this>/upload/<token>.
WORKER_PUBLIC_URL=https://gpu-01.school-x.tw

# ── Local storage ─────────────────────────────────────────────────
WORKER_STORAGE_ROOT=/var/lib/worker-agent/storage
WORKER_STATE_DIR=/var/lib/worker-agent/state

# ── GPU / runtime ─────────────────────────────────────────────────
GPU_ID=0
EVAL_MODE=real            # mock | real  (real = prebuilt Isaac Sim image below)
ISAAC_SIM_SCRIPT_PATH=/aicapstone/scripts/rollout.py
# Simulator source for the local real-mode build (setup.sh clones + builds).
# Eval task configs are fetched from central per job, not built in.
AICAPSTONE_REPO=https://github.com/asddzxcc1856/aicapstone.git
AICAPSTONE_REF=feat/eval-rollout-fixes-nb
# Mock smoke test only (no GPU, synthetic scores):
# COMPOSE_FILE=docker-compose.yml:docker-compose.mock.yml

# ── Loop tuning ───────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SEC=30
JOB_POLL_INTERVAL_SEC=10
REQUEST_TIMEOUT_SEC=30
WORKER_PORT=8080

# ── Capabilities (informational; central stores + admin sees) ─────
MAX_CONCURRENT_EVALS=1
ALLOWED_TASK_KEYS=cup_stacking,cutlery_arrangement,toy_block_collection

# ── HuggingFace weight downloads ──────────────────────────────────
# Optional. lerobot policy classes (multi_task_dit / smolvla / pi0 /
# groot / XVLA / act) fetch weights from huggingface.co on first eval.
# Anonymous requests are rate-limited; a read-scope token removes it.
# Get one at https://huggingface.co/settings/tokens.
HF_TOKEN=
