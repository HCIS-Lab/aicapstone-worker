# syntax = docker/dockerfile:1.7
# Real Isaac Sim worker image, built on the school's own machine.
#
# Layers the worker_agent runtime on top of the simulator base image
# (isaacsim 5.1 + IsaacLab + the aicapstone simulator + a Python 3.12
# lerobot sidecar venv), which setup.sh builds first from the pinned
# aicapstone checkout:
#
#   docker build -t aicapstone-sim:local -f aicapstone/Dockerfile aicapstone
#   docker compose build          # this file; see docker-compose.yml
#
# Build context = this worker directory. The aicapstone checkout comes in
# as the named context `aicapstone` (compose `additional_contexts`), e.g.
#   docker build -f Dockerfile.real --build-context aicapstone=./aicapstone .
#
# Eval task configs are NOT baked in: the worker fetches the config for
# each job from central (/api/workers/submissions/<id>/task-config), so
# every school grades with the version central currently holds.
#
# Requires an NVIDIA driver on the host + nvidia-container-toolkit.
ARG BASE_IMAGE=aicapstone-sim:local
FROM ${BASE_IMAGE}

# worker_agent's Python runtime deps — separate from the isaacsim
# environment installed in the base image.
RUN pip install --no-cache-dir \
        "fastapi==0.115.0" \
        "uvicorn[standard]==0.30.0" \
        "httpx==0.27.2" \
        "python-multipart==0.0.9" \
        "pydantic==2.9.0" \
        "pydantic-settings==2.5.0"

# Worker source (.dockerignore keeps .env and the aicapstone checkout out).
COPY . /app/worker_agent/

# The base image only installs packages/simulator; bake the rollout entry
# point (and its policy sidecar) from the same pinned checkout.
COPY --from=aicapstone scripts/ /workspace/aicapstone/scripts/

# The base image inherits ENTRYPOINT from isaacsim/IsaacLab launchers
# (`/isaac-sim/python.sh` in some layers). Override so the worker's
# main loop runs instead.
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    WORKER_STORAGE_ROOT=/var/lib/worker-agent/storage \
    WORKER_STATE_DIR=/var/lib/worker-agent/state \
    WORKER_PORT=8080
RUN mkdir -p /var/lib/worker-agent/storage /var/lib/worker-agent/state

# The worker's default `ISAAC_SIM_SCRIPT_PATH=/aicapstone/scripts/rollout.py`
# assumes the tree at /aicapstone; the base image installs it under
# /workspace/aicapstone.
RUN ln -snf /workspace/aicapstone /aicapstone

# Bake a pre-warmed Omniverse Kit cache captured from a `--validate_only`
# run of one of the eval tasks. Saves ~30s of shader-compile + registry
# lookup on a school's very first real eval. The cache is small (~15 MB
# uncompressed / 4 MB tarball) because heavy USDs are already baked into
# /workspace/aicapstone. Runtime writes to a mounted volume so this seed
# only matters until the volume grows its own copy.
COPY ov-cache.tgz /tmp/ov-cache.tgz
RUN mkdir -p /root/.cache/ov \
 && tar xzf /tmp/ov-cache.tgz -C /root/.cache/ov \
 && rm /tmp/ov-cache.tgz

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080
ENTRYPOINT []
# Invoke uvicorn directly so `worker_agent.main` is imported ONCE. Using
# `python -m worker_agent.main` also worked but Python treats the entry
# module both as `__main__` and as `worker_agent.main` — that duplicated
# every `@app.on_event('startup')` handler, spawning two heartbeat and
# two job-poll threads. `_startup` also has an idempotency guard now,
# but this belt-AND-braces prevents the whole class of issue.
CMD ["uvicorn", "worker_agent.main:app", "--host", "0.0.0.0", "--port", "8080"]
